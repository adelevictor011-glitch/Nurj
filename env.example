# Browser-safe Supabase values. These are embedded by Vite at build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only values for Vercel Functions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# Cheaper model used on outages and once spend passes 80% of the daily budget.
OPENAI_MODEL_FALLBACK=openai/gpt-oss-20b
# Daily AI budget in tokens (feature 19). Free and guest calls pause at 100%.
AI_DAILY_TOKEN_BUDGET=2000000
# Where spend alerts are emailed (uses RESEND_API_KEY and REMINDER_FROM_EMAIL).
ADMIN_ALERT_EMAIL=
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
APP_URL=http://localhost:5173

# Random 32+ char string. Salts guest IP hashes so raw IPs are never stored.
# Generate with: openssl rand -hex 32
GUEST_IP_SALT=REPLACE_ME

# Optional. Enables the daily expiry reminder email (api/cron/expiry-reminders).
# Without these the cron still runs and reports who is due, so you can send manually.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Nurj <hello@yourdomain.com>
# Optional. If set, the cron endpoint requires this bearer token.
CRON_SECRET=
